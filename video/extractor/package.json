{
  "name": "@variax-ai/video-extractor",
  "version": "0.0.2",
  "description": "Video to VideoDocument schema inference (extractor)",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@variax-ai/video-schema": "0.0.2"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "vitest": "^4.1.6"
  },
  "license": "MIT"
}
