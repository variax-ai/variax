{
  "name": "@variax-ai/video-extractor",
  "version": "0.3.1",
  "description": "Video to VideoDocument schema inference (extractor)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/variax-ai/variax.git",
    "directory": "video/extractor"
  },
  "homepage": "https://github.com/variax-ai/variax/tree/main/video/extractor#readme",
  "bugs": {
    "url": "https://github.com/variax-ai/variax/issues"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@variax-ai/video-schema": "0.3.1"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
